<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 20px; text-align: center; direction: ltr;">
  <div style="max-width: 400px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">

    <!-- HEADER -->
    <div style="background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%); padding: 40px 20px; color: #ffffff;">
      <h1 style="margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;">
        Dawrha
      </h1>
    </div>

    <!-- BODY -->
    <div style="padding: 35px; text-align: left; color: #2d3748;">
      <h2 style="color: #27ae60; font-size: 20px; font-weight: 700; margin-bottom: 15px;">
        Reset Your Password
      </h2>

      <p style="margin: 0 0 12px 0; font-size: 16px;">Hello,</p>

      <p style="margin: 0 0 25px 0; font-size: 15px; color: #4a5568; line-height: 1.6;">
        You requested to reset your password. Click the button below to set a new password.
      </p>

      <!-- BUTTON -->
      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= link %>"
           style="
             display: inline-block;
             background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
             color: #ffffff;
             padding: 14px 28px;
             border-radius: 8px;
             text-decoration: none;
             font-size: 16px;
             font-weight: 700;
             letter-spacing: 1px;
           ">
          Reset Password
        </a>
      </div>

      <p style="font-size: 14px; color: #718096; line-height: 1.6;">
        This link will expire in 10 minutes. If you did not request this, please ignore this email.
      </p>

      <!-- FOOTER -->
      <div style="border-top: 1px solid #e2e8f0; padding-top: 20px; margin-top: 20px;">
        <p style="margin: 0; font-size: 14px; font-weight: 700; color: #2d3748;">
          — The Dawrha Team
        </p>
    
    </div>
    <div style="background-color: #f7fafc; padding: 15px; text-align: center;">
     <p style="margin: 0; font-size: 12px; color: #a0aec0;">&copy; 2026 Dawrha App. All rights reserved.</p>
    </div>
      </div>
  </div>
</div>