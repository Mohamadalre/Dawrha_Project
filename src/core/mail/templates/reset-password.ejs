<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0b1120; padding: 20px; text-align: center; direction: ltr;">

  <!-- CARD -->
  <div style="max-width: 400px; margin: 0 auto; background-color: #020617; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 25px rgba(0,0,0,0.4);">

    <!-- HEADER -->
    <div style="background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); padding: 40px 20px; color: #ffffff;">
      <h1 style="margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;">
        Dawrha
      </h1>
    </div>

    <!-- BODY -->
    <div style="padding: 35px; text-align: left; color: #e2e8f0;">

      <h2 style="color: #22c55e; font-size: 20px; font-weight: 700; margin-bottom: 15px;">
        Password Verification Code
      </h2>

      <p style="margin: 0 0 12px 0; font-size: 16px;">
        Hello,
      </p>

      <p style="margin: 0 0 25px 0; font-size: 15px; color: #94a3b8; line-height: 1.6;">
        We received a request to reset your password. Please use the verification code below to continue.
      </p>

      <!-- OTP -->
      <div style="text-align: center; margin: 35px 0;">

        <p style="
          color:#94a3b8;
          font-size:14px;
          margin-bottom:12px;
        ">
          Your Verification Code
        </p>

        <div style="
          display:inline-block;
          background:#0f172a;
          border:2px dashed #22c55e;
          border-radius:12px;
          padding:16px 30px;
          color:#22c55e;
          font-size:32px;
          font-weight:800;
          letter-spacing:8px;
          font-family:monospace;
        ">
          <%= otp %>
        </div>

      </div>

      <p style="font-size: 14px; color: #64748b; line-height: 1.6;">
        This verification code will expire in 10 minutes.
        If you did not request a password reset, please ignore this email.
      </p>

      <!-- TEAM -->
      <div style="border-top: 1px solid #1e293b; padding-top: 20px; margin-top: 20px;">
        <p style="margin: 0; font-size: 14px; font-weight: 700; color: #e2e8f0;">
          — The Dawrha Team
        </p>
      </div>

    </div>

    <!-- FOOTER -->
    <div style="background-color: #020617; padding: 18px; text-align: center; border-top: 1px solid #1e293b;">
      <p style="margin: 0; font-size: 12px; color: #64748b;">
        &copy; 2026 Dawrha App. All rights reserved.
      </p>
    </div>

  </div>

</div>