<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 20px; text-align: center; direction: ltr;">
  
  <!-- CARD -->
  <div style="max-width: 400px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">

    <!-- HEADER -->
    <div style="background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%); padding: 40px 20px; color: #ffffff;">
      <h1 style="margin: 0;">Dawrha</h1>
    </div>

    <!-- BODY -->
    <div style="padding: 35px; background-color: #0f172a; color: #e2e8f0; text-align: left;">
      
      <h2 style="color: #22c55e;">Verify Your Account</h2>

      <p>Hello,</p>

      <p style="color: #94a3b8;">
        You requested a verification code for your Dawrha account.
      </p>

      <!-- OTP -->
      <div style="background-color: #020617; border-radius: 10px; padding: 25px; text-align: center; margin: 30px 0;">
        <span style="color: #38bdf8; font-size: 36px; letter-spacing: 12px;">
          <%= otp %>
        </span>
      </div>

      <p style="color: #64748b;">
        Enter this code in the Dawrha app to continue. If you did not request this code, please ignore this email.
      </p>

      <div style="border-top: 1px solid #1e293b; margin-top: 20px; padding-top: 15px;">
        <p style="margin: 0; font-weight: bold;">
          — The Dawrha Team
        </p>
      </div>

    </div>


    <div style="background-color: #111827; padding: 15px; text-align: center;">
      <p style="margin: 0; font-size: 12px; color: #9ca3af;">
        &copy; 2026 Dawrha App. All rights reserved.
      </p>
    </div>

  </div>
</div>