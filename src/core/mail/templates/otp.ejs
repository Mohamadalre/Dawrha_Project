<div style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 20px; text-align: center; direction: ltr;">
    <div style="max-width: 400px; margin: 0 auto; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
        <div style="background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%); padding: 40px 20px; color: #ffffff;">
            <h1 style="margin: 0; font-size: 28px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase;">Dawrha</h1>
        </div>

        <div style="padding: 35px; text-align: left; color: #2d3748;">
            <h2 style="color: #27ae60; font-size: 20px; font-weight: 700; margin-bottom: 15px;">Verify Your Account</h2>
            <p style="margin: 0 0 12px 0; font-size: 16px;">Hello,</p>
            <p style="margin: 0 0 25px 0; font-size: 15px; color: #4a5568; line-height: 1.6;">
                You requested a verification code for your Dawrha account. Please use the following code:
            </p>

            <div style="background-color: #1a202c; border-radius: 10px; padding: 25px; text-align: center; margin: 30px 0; border: 1px solid #2d3748;">
                <span style="color: #63b3ed; font-size: 36px; font-weight: 800; letter-spacing: 12px; font-family: 'Courier New', monospace;">
                    <%= otp %>
                </span>
            </div>

            <p style="font-size: 14px; color: #718096; line-height: 1.6; margin-bottom: 25px;">
                Enter this code in the Dawrha app to continue.
            </p>

            <div style="border-top: 1px solid #e2e8f0; padding-top: 20px;">
                <p style="margin: 0; font-size: 14px; font-weight: 700; color: #2d3748;">— The Dawrha Team</p>
            </div>
        </div>
    </div>
</div>