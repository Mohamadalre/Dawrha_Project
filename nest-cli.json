{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include":"./core/mail/templates",
        "outDir": "dist/src",
        "watchAssets": true
        },
      {
        "include": "./i18n/**/*.json",
        "outDir": "dist/src",
        "watchAssets": true
        }
    ]
  }
}
